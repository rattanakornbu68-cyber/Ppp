<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ภารกิจพิชิตสมรรถภาพทางกาย - เกมเศรษฐีพลศึกษา</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Prompt -->
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Canvas Confetti for Victory Celebration -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        * {
            font-family: 'Prompt', sans-serif;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #10B981;
            border-radius: 10px;
        }

        /* 3D Dice styling */
        .dice-container {
            perspective: 600px;
        }
        .dice {
            width: 60px;
            height: 60px;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 1s ease-out;
        }
        .dice-face {
            position: absolute;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #ffffff, #f1f5f9);
            border: 2px solid #cbd5e1;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.08), 0 6px 12px rgba(0,0,0,0.15);
        }

        /* Pulse animation for active player turn */
        @keyframes activePulse {
            0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
            50% { transform: scale(1.02); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
        }
        .active-turn {
            animation: activePulse 2s infinite;
        }

        /* Token animation on tile */
        .token-bounce {
            animation: bounce 0.6s ease infinite alternate;
        }
        @keyframes bounce {
            from { transform: translateY(0); }
            to { transform: translateY(-5px); }
        }

        /* 7x7 CSS Grid Board layout */
        .board-grid {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            grid-template-rows: repeat(7, minmax(0, 1fr));
            gap: 4px;
        }

        .tile-corner {
            background: linear-gradient(135deg, #fef3c7, #fde047);
        }

        /* Custom pulse for timer warning */
        @keyframes timerAlert {
            0%, 100% { background-color: rgba(239, 68, 68, 0.2); }
            50% { background-color: rgba(239, 68, 68, 0.7); }
        }
        .timer-warning {
            animation: timerAlert 1s infinite;
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 flex flex-col justify-between overflow-x-hidden">

    <!-- TOP BAR / HEADER -->
    <header class="bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 text-white shadow-lg sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="bg-white/20 p-2.5 rounded-2xl backdrop-blur-md text-2xl shadow-inner">
                    🏃‍♂️
                </div>
                <div>
                    <h1 class="text-lg sm:text-2xl font-black tracking-wide drop-shadow-sm flex items-center gap-2">
                        <span>ภารกิจพิชิตสมรรถภาพทางกาย</span>
                    </h1>
                    <p class="text-xs text-emerald-100 hidden sm:block">เกมเศรษฐีพลศึกษา สนุก สดใส ได้สุขภาพสำหรับนักเรียน</p>
                </div>
            </div>

            <!-- Timer & Exit Controls -->
            <div id="gameHeaderControls" class="hidden flex items-center gap-2 sm:gap-3">
                <!-- 6-Minute Timer Display -->
                <div id="timerContainer" class="bg-slate-900/50 backdrop-blur-md px-3.5 py-1.5 rounded-2xl border border-white/20 flex items-center gap-2 transition-colors">
                    <span class="text-base sm:text-lg">⏱️</span>
                    <span id="timerDisplay" class="font-mono font-extrabold text-base sm:text-xl text-amber-300">06:00</span>
                </div>
                <!-- Return Home Button -->
                <button onclick="openConfirmExitModal()" class="bg-red-500/80 hover:bg-red-600 active:scale-95 text-white px-3 py-1.5 rounded-xl transition text-xs sm:text-sm font-bold flex items-center gap-1 shadow border border-white/20">
                    <span>🏠</span> <span class="hidden md:inline">กลับหน้าแรก</span>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-7xl w-full mx-auto p-2 sm:p-4 flex-grow flex flex-col justify-center">

        <!-- VIEW 1: SETUP SCREEN -->
