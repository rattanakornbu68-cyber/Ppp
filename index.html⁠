            resultText.innerText = "กำลังทอยลูกเต๋า...";

            const rollValue = Math.floor(Math.random() * 6) + 1;

            const rotations = [
                { x: 0, y: 0 },
                { x: 0, y: 180 },
                { x: 0, y: -90 },
                { x: 0, y: 90 },
                { x: -90, y: 0 },
                { x: 90, y: 0 }
            ];
            const rot = rotations[rollValue - 1];
            dice.style.transform = `rotateX(${rot.x + 720}deg) rotateY(${rot.y + 720}deg)`;

            setTimeout(() => {
                resultText.innerText = `${player.name} ทอยได้ ${rollValue} แต้ม! 🎲`;
                movePlayerSteps(player, rollValue);
            }, 1000);
        }

        function movePlayerSteps(player, steps) {
            let stepCount = 0;
            const stepInterval = setInterval(() => {
                stepCount++;
                player.position = (player.position + 1) % 24;
                renderTokensOnBoard();
                playSound('dice');

                if (player.position === 23) {
                    clearInterval(stepInterval);
                    player.score += 5;
                    updateScoreboard();
                    setTimeout(() => {
                        triggerFinishGame(player, `${player.name} เข้าเส้นชัย (FINISH) เป็นคนแรก! 🏁`);
                    }, 500);
                    return;
                }

                if (stepCount >= steps) {
                    clearInterval(stepInterval);
                    setTimeout(() => {
                        handleTileAction(player);
                    }, 400);
                }
            }, 300);
        }

        function handleTileAction(player) {
            const currentTile = BOARD_TILES[player.position];

            switch (currentTile.type) {
                case 'question':
                    openQuestionModal();
                    break;

                case 'mission':
                case 'fitness':
                    openMissionModal(currentTile.type);
                    break;

                case 'bonus':
                    player.score += 2;
                    playSound('bonus');
                    updateScoreboard();
                    showNoticeModal('⭐ ช่องโบนัสพิเศษ', `${player.name} ตกช่องโบนัส! ได้รับ +2 คะแนน 🎉`);
                    break;

                case 'rest':
                    player.isResting = true;
                    updateScoreboard();
                    showNoticeModal('⏸️ ช่องพักผ่อน', `${player.name} ตกช่องพัก! ต้องพักในรอบถัดไป 1 รอบ`);
                    break;

                case 'start':
                    player.score += 2;
                    updateScoreboard();
                    showNoticeModal('🚩 ช่องจุดเริ่มต้น', `${player.name} ผ่าน/ตกช่อง START! ได้รับ +2 คะแนน`);
                    break;

                case 'finish':
                    triggerFinishGame(player, `${player.name} เดินถึงเส้นชัย (FINISH)! 🏁`);
                    break;

                default:
                    finishTurn();
            }
        }

        function openQuestionModal() {
            currentQuestionIndex = Math.floor(Math.random() * QUESTIONS_BANK.length);
            const qObj = QUESTIONS_BANK[currentQuestionIndex];

            document.getElementById('questionText').innerText = qObj.q;
            const optionsContainer = document.getElementById('questionOptions');
            optionsContainer.innerHTML = '';
            
            const feedback = document.getElementById('questionFeedback');
            feedback.className = "text-center font-black text-sm hidden py-2 rounded-xl mb-1";

            qObj.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left bg-slate-50 hover:bg-blue-50 border-2 border-slate-200 hover:border-blue-400 p-3 rounded-2xl font-bold text-slate-800 transition flex items-center gap-3 active:scale-98";
                btn.innerHTML = `
                    <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 font-black text-xs flex items-center justify-center shrink-0">${String.fromCharCode(65 + idx)}</span>
                    <span class="text-xs sm:text-sm">${opt}</span>
                `;
                btn.onclick = () => answerQuestion(idx);
                optionsContainer.appendChild(btn);
            });

            document.getElementById('questionModal').classList.remove('hidden');
        }

        function answerQuestion(selectedIdx) {
            const qObj = QUESTIONS_BANK[currentQuestionIndex];
            const player = players[currentTurnIndex];
            const feedback = document.getElementById('questionFeedback');

            const btns = document.querySelectorAll('#questionOptions button');
            btns.forEach(b => b.disabled = true);

            if (selectedIdx === qObj.ans) {
                player.score += 2;
                playSound('correct');
                feedback.innerText = "ถูกต้อง! 🎉 ได้รับ +2 คะแนน";
                feedback.className = "text-center font-black text-sm block py-2 rounded-xl mb-1 bg-emerald-100 text-emerald-800 border border-emerald-300";
            } else {
                playSound('wrong');
                feedback.innerText = `ตอบผิด! ❌ คำตอบที่ถูกต้องคือ: ${qObj.options[qObj.ans]}`;
                feedback.className = "text-center font-black text-sm block py-2 rounded-xl mb-1 bg-rose-100 text-rose-800 border border-rose-300";
            }

            updateScoreboard();

            setTimeout(() => {
                document.getElementById('questionModal').classList.add('hidden');
                finishTurn();
            }, 1800);
        }

        function openMissionModal(tileType) {
            const mission = MISSIONS_BANK[Math.floor(Math.random() * MISSIONS_BANK.length)];
            pendingMissionPoints = mission.points;

            document.getElementById('missionIconBg').innerText = mission.icon;
            document.getElementById('missionTitle').innerText = tileType === 'fitness' ? '💪 ท้าทายสมรรถภาพทางกาย' : '🏃 ภารกิจพลศึกษา';
            document.getElementById('missionDesc').innerText = `${mission.title}: ${mission.desc}`;
            document.getElementById('missionPointsBadge').innerText = `+${mission.points} คะแนน`;

            document.getElementById('missionModal').classList.remove('hidden');
        }

        function completeMission() {
            const player = players[currentTurnIndex];
            player.score += pendingMissionPoints;
            playSound('correct');
            updateScoreboard();

            document.getElementById('missionModal').classList.add('hidden');
            finishTurn();
        }

        function showNoticeModal(title, desc) {
            document.getElementById('noticeTitle').innerText = title;
            document.getElementById('noticeDesc').innerText = desc;
            document.getElementById('specialNoticeModal').classList.remove('hidden');
        }

        function closeNoticeModal() {
            document.getElementById('specialNoticeModal').classList.add('hidden');
            finishTurn();
        }

        function finishTurn() {
            isRolling = false;
            document.getElementById('rollDiceBtn').disabled = false;
            nextTurn();
        }

        function nextTurn() {
            currentTurnIndex = (currentTurnIndex + 1) % players.length;
            updateTurnBadge();
            updateScoreboard();
        }

        function startTimer() {
            if (gameTimer) clearInterval(gameTimer);

            gameTimer = setInterval(() => {
                remainingSeconds--;

                const mins = Math.floor(remainingSeconds / 60);
                const secs = remainingSeconds % 60;
                document.getElementById('timerDisplay').innerText = 
                    `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

                if (remainingSeconds === 60 && !warningShown) {
                    warningShown = true;
                    document.getElementById('timerContainer').classList.add('timer-warning');
                    showNoticeModal('⏰ เหลือเวลาอีก 1 นาที!', 'เหลือเวลาแข่งขันอีกเพียง 60 วินาทีสุดท้าย!');
                }

                if (remainingSeconds <= 0) {
                    clearInterval(gameTimer);
                    triggerFinishGame(null, '⏱ หมดเวลาการแข่งขัน 6 นาที!');
                }
            }, 1000);
        }

        function triggerFinishGame(winnerPlayer, reasonText) {
            if (isGameEnded) return;
            isGameEnded = true;
            if (gameTimer) clearInterval(gameTimer);

            document.getElementById('gameOverReasonText').innerText = reasonText || 'ภารกิจพิชิตสมรรถภาพทางกาย สำเร็จลุล่วง!';

            const ranked = [...players].sort((a, b) => b.score - a.score);

            const podium = document.getElementById('podiumContainer');
            podium.innerHTML = '';

            const podiumOrder = [
                ranked[1],
                ranked[0],
                ranked[2]
            ].filter(Boolean);

            podiumOrder.forEach((p) => {
                const rankIdx = ranked.indexOf(p);
                let height = 'h-24';
                let bg = 'bg-slate-200';
                let medal = '🥇';

                if (rankIdx === 0) {
                    height = 'h-32';
                    bg = 'bg-gradient-to-t from-amber-400 via-yellow-300 to-amber-200 border-2 border-amber-500';
                    medal = '🥇';
                } else if (rankIdx === 1) {
                    height = 'h-24';
                    bg = 'bg-gradient-to-t from-slate-300 to-slate-200 border-2 border-slate-400';
                    medal = '🥈';
                } else if (rankIdx === 2) {
                    height = 'h-20';
                    bg = 'bg-gradient-to-t from-amber-800/30 to-amber-700/20 border-2 border-amber-700';
                    medal = '🥉';
                }

                const col = document.createElement('div');
                col.className = "flex flex-col items-center justify-end w-1/3 max-w-[100px]";
                col.innerHTML = `
                    <div class="text-2xl mb-1">${p.tokenEmoji}</div>
                    <div class="text-xs font-black text-slate-800 truncate max-w-full mb-1">${p.name}</div>
                    <div class="${height} ${bg} w-full rounded-t-2xl flex flex-col items-center justify-center p-1 shadow">
                        <span class="text-2xl">${medal}</span>
                        <span class="text-xs font-black text-slate-800 mt-1">${p.score} คะแนน</span>
                    </div>
                `;
                podium.appendChild(col);
            });

            const list = document.getElementById('finalLeaderboard');
            list.innerHTML = '';

            ranked.forEach((p, idx) => {
                const row = document.createElement('div');
                row.className = "p-3 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between";
                row.innerHTML = `
                    <div class="flex items-center gap-3">
                        <span class="font-black text-slate-500 text-sm w-5">${idx + 1}.</span>
                        <span class="text-lg">${p.tokenEmoji}</span>
                        <span class="font-black text-slate-800 text-sm">${p.name}</span>
                    </div>
                    <div class="font-black text-emerald-600 text-base">${p.score} คะแนน</div>
                `;
                list.appendChild(row);
            });

            try {
                confetti({
                    particleCount: 120,
                    spread: 80,
                    origin: { y: 0.6 }
                });
            } catch(e) {}

            document.getElementById('gameOverModal').classList.remove('hidden');
        }

        function restartGame() {
            document.getElementById('gameOverModal').classList.add('hidden');
            document.getElementById('timerContainer').classList.remove('timer-warning');
            startGame();
        }

        function returnToHome() {
            document.getElementById('confirmExitModal').classList.add('hidden');
            document.getElementById('gameOverModal').classList.add('hidden');
            document.getElementById('gameScreen').classList.add('hidden');
            document.getElementById('gameHeaderControls').classList.add('hidden');
            document.getElementById('timerContainer').classList.remove('timer-warning');
            document.getElementById('setupScreen').classList.remove('hidden');
            if (gameTimer) clearInterval(gameTimer);
        }

        function openConfirmExitModal() {
            document.getElementById('confirmExitModal').classList.remove('hidden');
        }

        function closeConfirmExitModal() {
            document.getElementById('confirmExitModal').classList.add('hidden');
        }
    </script>
</body>
</html>
