            <button onclick="completeMission()" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 active:scale-98 text-white font-black py-3.5 rounded-2xl shadow-lg transition flex items-center justify-center gap-2 text-lg">
