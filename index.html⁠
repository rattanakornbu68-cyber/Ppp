                    <button type="button" onclick="setPlayerCount(3)" class="player-count-btn bg-white hover:bg-emerald-50 text-slate-700 border-2 border-slate-200 font-extrabold py-2.5 rounded-xl transition text-center shadow-sm" data-count="3">3 คน</button>
                    <button type="button" onclick="setPlayerCount(4)" class="player-count-btn bg-emerald-600 text-white border-2 border-emerald-600 font-extrabold py-2.5 rounded-xl transition text-center shadow-sm" data-count="4">4 คน</button>
                    <button type="button" onclick="setPlayerCount(5)" class="player-count-btn bg-white hover:bg-emerald-50 text-slate-700 border-2 border-slate-200 font-extrabold py-2.5 rounded-xl transition text-center shadow-sm" data-count="5">5 คน</button>
